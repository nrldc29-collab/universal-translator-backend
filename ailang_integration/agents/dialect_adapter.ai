# Dialect Adapter — regional dialect detection and targeting
model claude { provider: "anthropic" name: "claude-sonnet-4-20250514" }
model fast   { provider: "anthropic" name: "claude-haiku-4-5-20251001" }

const DIALECT_MAP = {
    "es": ["es-ES", "es-MX", "es-AR", "es-CO", "es-CL"],
    "pt": ["pt-BR", "pt-PT"],
    "zh": ["zh-CN", "zh-TW", "zh-HK"],
    "ar": ["ar-SA", "ar-EG", "ar-MA", "ar-LB"],
    "en": ["en-US", "en-GB", "en-AU", "en-IN", "en-CA"],
    "fr": ["fr-FR", "fr-CA", "fr-BE"],
    "de": ["de-DE", "de-AT", "de-CH"]
}

const DIALECT_HINTS = {
    "es-MX": "Use Mexican Spanish. Prefer 'carro' over 'coche', 'camion' for bus. Use 'ustedes' not 'vosotros'.",
    "es-ES": "Use Spain Spanish. 'vosotros' is appropriate. 'coche' for car, 'autobuses' for bus.",
    "es-AR": "Use Rioplatense Spanish. Use 'vos' instead of 'tu'.",
    "pt-BR": "Use Brazilian Portuguese. 'voce' preferred. 'onibus' for bus, 'celular' for phone.",
    "pt-PT": "Use European Portuguese. 'autocarro' for bus, 'telemovel' for phone.",
    "zh-CN": "Use Simplified Chinese (Mandarin, mainland). Simplified characters.",
    "zh-TW": "Use Traditional Chinese (Taiwan). Traditional characters.",
    "zh-HK": "Use Traditional Chinese with Cantonese influences (Hong Kong).",
    "en-GB": "Use British English. 'lift' not 'elevator', 'flat' not 'apartment', '-ise' endings.",
    "en-US": "Use American English. Standard vocabulary. '-ize' endings.",
    "fr-CA": "Use Canadian French (Quebecois). 'courriel' for email.",
    "ar-EG": "Use Egyptian Arabic dialect.",
    "ar-SA": "Use Modern Standard Arabic / Gulf Arabic."
}

fn detect_dialect_from_text(text: string, lang: string): string {
    dialects = get_value(DIALECT_MAP, lang)
    if dialects == null { return lang }
    prompt = f"Detect the regional dialect variant of this {lang} text. Text: {text}. Possible dialects: {to_json(dialects)}. Return ONLY the dialect code (e.g. es-MX) or '{lang}' if unclear."
    return trim(ask fast: prompt)
}

fn get_dialect_hint(dialect_code: string): string {
    hint = get_value(DIALECT_HINTS, dialect_code)
    if hint == null { return "" }
    return hint
}

fn adapt_to_dialect(base_translation: string, target_dialect: string): string {
    hint = get_dialect_hint(target_dialect)
    if length(hint) == 0 { return base_translation }
    prompt = f"Adapt this translation to {target_dialect} dialect. {hint}. Translation: {base_translation}. Return ONLY the adapted translation."
    return ask fast: prompt
}

fn resolve_target_dialect(lang: string, user_preference: string): string {
    if length(user_preference) > 2 { return user_preference }
    defaults = {"es": "es-MX", "pt": "pt-BR", "zh": "zh-CN", "ar": "ar-EG", "en": "en-US", "fr": "fr-FR", "de": "de-DE"}
    default_dialect = get_value(defaults, lang)
    if default_dialect != null { return default_dialect }
    return lang
}

agent DialectAdapterAgent(claude) {
    instructions: "You detect source dialects and adapt translations to the correct regional variant of the target language."
    tools: detect_dialect_from_text, get_dialect_hint, adapt_to_dialect, resolve_target_dialect

    fn process(source_text: string, base_translation: string, source_lang: string, target_lang: string, dialect_preference: string): dict {
        source_dialect = detect_dialect_from_text(source_text, source_lang)
        target_dialect = resolve_target_dialect(target_lang, dialect_preference)
        adapted        = adapt_to_dialect(base_translation, target_dialect)

        return {
            "final_translation":  adapted,
            "source_dialect":     source_dialect,
            "target_dialect":     target_dialect,
            "adaptation_applied": adapted != base_translation
        }
    }
}

fn main() {
    result = DialectAdapterAgent.process("Can you take the bus to the hospital?", "Puedes tomar el autobus al hospital?", "en", "es", "es-MX")
    print(result)
}
