# Runtime
# PRODUCTION: Set ENVIRONMENT=production to enable production safety checks
ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://127.0.0.1:5173
SERVE_FRONTEND_DIST=0
FRONTEND_DIST_DIR=frontend/dist
EVENT_LOG_PATH=logs/events.jsonl

# Auth and quotas
# PRODUCTION REQUIRED: Generate strong secrets — python scripts/generate_secrets.py
# Server will REFUSE to start if these placeholder values are used with ENVIRONMENT=production
JWT_SECRET=change-me-before-production
# PRODUCTION REQUIRED: Replace with real credentials, e.g. alice:strongpassword,bob:anotherpassword
# When DATA_DIR is set, use /admin/users API to manage users in the SQLite DB instead
USERS=demo:demo
USER_TIERS=demo:free
API_KEYS=
# Admin usernames allowed to call /admin/users (comma-separated, must match JWT subject)
ADMIN_IDENTITIES=
REQUESTS_PER_MINUTE=120
QUOTA_REQUESTS_PER_HOUR=500
FREE_DAILY_AUDIO_MINUTES=10
SESSION_MINUTES=480

# CORS
# PRODUCTION REQUIRED: Set to your actual deployed frontend URL, e.g. https://app.yourdomain.com
# Server will REFUSE to start if placeholder example.com domains remain in production
# Development: Keep localhost for local testing
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1|192\.168\.\d{1,3}\.\d{1,3}|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[0-1])\.\d{1,3}\.\d{1,3})(:\d+)?

# Stable Cloudflare tunnel for phone access.
# Preferred dashboard-token mode: create a Cloudflare Tunnel + Public Hostname,
# then put the token in logs/stable-tunnel-token.txt and set ANAI_TUNNEL_TOKEN_FILE.
# CLI/cert mode: run Setup-StableTunnel.ps1 with ANAI_TUNNEL_NAME and hostname.
# Tunnel provider: cloudflare, localhost-run, or localtunnel.
ANAI_TUNNEL_PROVIDER=cloudflare
ANAI_TUNNEL_HOSTNAME=
ANAI_TUNNEL_NAME=
ANAI_TUNNEL_TOKEN_FILE=

# Fixed fallback phone link when Cloudflare cert/token is not available.
# Example output URL: https://anai-translator-nrldc.loca.lt
ANAI_LOCALTUNNEL_SUBDOMAIN=

# Speech-to-text
USE_GPU=0
GPU_COST_MODE=low
GPU_MEMORY_USED_MB=0
GPU_UTILIZATION_PERCENT=0
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_SIZE=small
WHISPER_CPU_THREADS=4
WHISPER_NUM_WORKERS=1
WHISPER_BEAM_SIZE=1
STT_MAX_CONCURRENCY=2
STT_QUEUE_MAX_DEPTH=8

# Translation
TRANSLATION_BACKEND=marian
TRANSLATION_DEVICE=cpu
# Marian/NLLB decode beams (1=fast greedy; quality mode uses QUALITY beams on /translate/text)
TRANSLATION_NUM_BEAMS=1
TRANSLATION_QUALITY_NUM_BEAMS=4
# NLLB fallback for pairs without MarianMT (e.g. en<->ht). Try facebook/nllb-200-1.3B for quality.
NLLB_MODEL=facebook/nllb-200-distilled-600M
REMOTE_TRANSLATION_TIMEOUT_SECONDS=0.65
HYBRID_ENABLE_MARIAN_FALLBACK=1
# Set to 1 for fast cloud translation fallback (recommended for local dev)
HYBRID_ENABLE_REMOTE=1
# Prime cloud translation cache for all 14 languages on startup
REMOTE_TRANSLATION_WARMUP=1
CONFIDENCE_WARNING_THRESHOLD=0.72
HIGH_STAKES_CONFIDENCE_THRESHOLD=0.78
CIP_MODE=ut_first
CIP_DEFAULT_MODE=ut_first
CIP_PROCESS_URL=
CIP_TIMEOUT_SECONDS=0.65
CIP_RETRIES=0
CIP_CONFIDENCE_THRESHOLD=0.42
CIP_AMBIGUITY_THRESHOLD=0.68

# AILang advanced-translation agents (context memory, confidence fallback,
# speaker profiling, ambiguity, back-translation, dialect, glossary, emotion TTS).
# The vendored ailang/ package + ailang_integration/ ship inside the image.
# LLM providers are tried in order: Ollama (local) -> OpenAI (cloud) -> CIP -> stub
# Set USE_LLM_AGENTS=true to force-enable, or just set OLLAMA_ENABLED=true or
# OPENAI_API_KEY and the pipeline auto-detects LLM availability.
AILANG_ENABLED=1
USE_LLM_AGENTS=false

# Ollama — local LLM, zero cost, no API key, runs fully offline.
# Install: powershell -File Setup-Ollama.ps1
# Or manually: https://ollama.com  then: ollama pull mistral
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT_SECONDS=30

# OpenAI — cloud LLM, requires API key with billing.
OPENAI_API_KEY=

# Model directories (Whisper/Marian cache on first use; Piper voices via setup script)
PRELOAD_MODELS=1
MAX_AUDIO_MB=25
MAX_AUDIO_SECONDS=300
CLIENT_VAD_MODE=1
CLIENT_VAD_THRESHOLD=0.055
VAD_RECENT_CHUNKS=2
VAD_SILENT_CHECKS=1
VAD_FORCE_FINAL_SECONDS=0.25
SPEECH_MERGE_MS=40
MIN_SPEECH_BYTES=4000
PARTIAL_STT_MIN_BYTES=1200
PARTIAL_STT_INTERVAL_MS=100
PARTIAL_TRANSLATION_MIN_WORDS=1
PARTIAL_TTS_MODE=1
TTS_NATURAL_VOICE=1
TTS_MAX_SINGLE_PASS_CHARS=320
TTS_PROSODY_WARMTH=0
NEAR_ZERO_LATENCY_MODE=1
STREAM_BUFFER_MAX_MB=12
MAX_ACTIVE_STREAMS_PER_USER=5
PIPELINE_STEP_TIMEOUT_SECONDS=10
STREAM_HOT_PATH_LOGGING=0

# TTS — natural voice (neural Edge TTS by default; Piper/eSpeak as fallback)
TTS_CHUNK_CHARS=48
TTS_FIRST_CHUNK_CHARS=28
TTS_VOICE_PROFILE=neural
TTS_NEURAL_MINIMAL_PROCESSING=1
# natural | soothing | plain — post-processing warmth (soothing = warmest)
PREFER_EDGE_TTS=1
TTS_EDGE_SSML_PAUSES=0
TTS_NATURAL_SPEED=1.0
TTS_NATURAL_PITCH_SHIFT=0
TTS_SOFTENING_ENABLED=1
# Local-first cloud: set PREFER_CLOUD_TTS=1 when GOOGLE_TTS_API_KEY is set
PREFER_CLOUD_TTS=0
# Google Cloud Text-to-Speech API key (optional — Neural2 / ht-HT voices)
# Get one from: https://console.cloud.google.com/apis/credentials
GOOGLE_TTS_API_KEY=
ELEVENLABS_API_KEY=

# Workers (app.py / uvicorn)
# IMPORTANT: Keep WORKERS=1 when USE_GPU=1 — GPU models cannot be shared across OS processes.
# Use horizontal pod/container scaling instead of increasing WORKERS for more throughput.
WORKERS=1

# Persistence — set DATA_DIR to enable SQLite-backed quota and user storage.
# Without DATA_DIR, all quotas and sessions reset on restart (in-memory only).
# Example: DATA_DIR=data  (creates data/anai.sqlite3)
DATA_DIR=

# Session and memory limits
SESSION_TTL_SECONDS=1800
SESSION_HISTORY_LIMIT=20
SEMANTIC_HISTORY_LIMIT=12
TOPIC_LIMIT=25

# STT Provider
# local: Use in-process Whisper (default)
# streaming: Use external STT provider service
STT_PROVIDER=local

# Streaming STT provider URLs (when STT_PROVIDER=streaming)
# Development: Use http://127.0.0.1:8002 and ws://127.0.0.1:8002/stt/stream
# Production: Use https://your-stt-provider-domain and wss://your-stt-provider-domain/stt/stream
STT_PROVIDER_URL=http://127.0.0.1:8002
STT_PROVIDER_WS_URL=ws://127.0.0.1:8002/stt/stream

# API key for streaming STT provider (must match STT_API_KEYS in provider)
# Generate with: python scripts/generate_secrets.py
STT_PROVIDER_API_KEY=

# STT provider admin and per-client API keys (used in docker-compose services)
# Generate with: python scripts/generate_secrets.py
STT_API_KEY=
ADMIN_API_KEY=

# Advanced Optimization Features
# Enable predictive translation caching for repeated phrases
ENABLE_PREDICTIVE_CACHE=1
PREDICTIVE_CACHE_SIZE=1000
PREDICTIVE_CACHE_TTL=3600

# Enable adaptive VAD for environmental awareness
ENABLE_ADAPTIVE_VAD=1

# Enable smart buffering with priority management
ENABLE_SMART_BUFFER=1

# Enable audio enhancement (noise reduction, AGC, normalization)
ENABLE_AUDIO_ENHANCEMENT=1

# Enable latency optimizer with dynamic quality adjustment
ENABLE_LATENCY_OPTIMIZER=1
