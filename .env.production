# Production Backend Configuration
# Set these environment variables when deploying to anai.wok

ENVIRONMENT=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# GPU Configuration
USE_GPU=1
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16  # float16 for GPU, int8 for CPU
WHISPER_MODEL_SIZE=base       # tiny, base, small, medium, large

# Performance Tuning
STT_MAX_CONCURRENCY=2
WHISPER_BEAM_SIZE=1
GPU_COST_MODE=balanced        # low or balanced

# CORS: Allow frontend requests
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.example.com,https://anai.wok
