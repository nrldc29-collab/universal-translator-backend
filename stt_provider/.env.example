# Environment
# dev: Development mode (allows missing API keys for testing)
# prod: Production mode (requires STT_API_KEY to be configured)
ENV=dev

# API Keys
# IMPORTANT: Generate strong secrets for production. See ../scripts/generate_secrets.py
# STT_API_KEY: Main client API key for transcription
# STT_API_KEYS: Labeled keys in format label:key (e.g., browser:key1,cli:key2)
# ADMIN_API_KEY: Admin key for administrative operations
STT_API_KEY=
STT_API_KEYS=
ADMIN_API_KEY=

# Security
# Speaker embedding encryption key (must be at least 32 characters for production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SPEAKER_EMBEDDING_ENCRYPTION_KEY=change-me-to-at-least-32-characters-for-production

# Whisper Model Configuration
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TRANSCRIPTION_LANGUAGE=en

# Audio Configuration
SAMPLE_RATE=16000
CHANNELS=1
FRAME_MS=30
VAD_MODE=2
MAX_SESSION_SECONDS=1800
IDLE_TIMEOUT_SECONDS=60
MAX_AUDIO_FRAME_BYTES=262144

# Connection Limits
MAX_CONNECTIONS_PER_KEY=3
MAX_ACTIVE_CONNECTIONS=10

# CORS Origins
# Production: Use only your actual translator domain, e.g., https://your-translator-domain.com
# Development: Keep localhost for local testing
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server Port
PORT=8002
