{
  "expo": {
    "name": "Anai",
    "slug": "anai-translator",
    "version": "1.0.2",
    "description": "Real-time conversation bridge — tap Start talking for cloud mode, or connect your own bridge. EN↔HT and 14 languages.",
    "runtimeVersion": "2026-06-11-fix152",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "anaitranslator",
    "userInterfaceStyle": "dark",
    "extra": {
      "apiUrl": "",
      "cloudApiUrl": "https://universal-translator-backend-production.up.railway.app",
      "cloudDemoUser": "demo",
      "consumerOpenAndGo": true,
      "privacyPolicyUrl": "https://universal-translator-backend-production.up.railway.app/privacy.html",
      "eas": {
        "projectId": "38c5acaf-9582-4533-8822-a31f06a6e21d"
      }
    },
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anaitranslator.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Anai needs microphone access to hear your side of the conversation bridge.",
        "NSLocalNetworkUsageDescription": "Anai connects to your local bridge server on the same Wi‑Fi.",
        "NSBonjourServices": [
          "_expo._tcp"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.anaitranslator.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#03050a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#03050a",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Anai needs microphone access to capture speech for real-time translation."
        }
      ],
      "./plugins/withAndroidCleartext",
      "expo-font",
      "expo-build-properties"
    ]
  }
}
