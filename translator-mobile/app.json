{
  "expo": {
    "name": "Anai Translator",
    "slug": "anai-translator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "anaitranslator",
    "userInterfaceStyle": "dark",
    "extra": {
      "apiUrl": "",
      "eas": {
        "projectId": "38c5acaf-9582-4533-8822-a31f06a6e21d"
      }
    },
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anaitranslator.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Anai Translator needs microphone access to capture speech for real-time translation.",
        "NSLocalNetworkUsageDescription": "Anai Translator connects to your local translation server.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.anaitranslator.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#03050a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#03050a",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Anai Translator needs microphone access to capture speech for real-time translation."
        }
      ],
      "./plugins/withAndroidCleartext",
      "expo-font"
    ]
  }
}
